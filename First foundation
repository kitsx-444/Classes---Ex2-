class Currency():
	def __init__(self, code, score, trend):
		self.code = code
		self.score = int(score)
		self.trend = trend

	def rating(self):
		if self.score >= 75:
			rating = self.rating() # That calls the method and stores the result. Then use rating in your f-string.
			print('Strong')
		elif self.score <= 74 and self.score >= 50:
			rating = self.rating()
			print('Moderate')
		else:
			rating = self.rating()
			print('Weak')
		return rating

	def display(self, rating):
		print(f'Currency: {self.code}')
		print(f'Score: {self.score}')
		print(f'Trend: {self.trend}')
		print(f'Rating: {rating}')


currency1 = Currency('USD', 42, 'Weak')
currency2 = Currency('EUR', 55, 'Neutral')
