class Currency():
	def __init__(self, code, score, trend):
		self.code = code
		self.score = int(score)
		self.trend = trend
	def rating(self):
		if self.score >= 75:
			rating = 'Strong'
		elif self.score <= 74 and self.score >= 50:
			rating = 'Moderate'
		else:
			rating = 'Weak'
		return rating
	def display(self, rating): # Rating is already in the class I don't have to pass it in as a parameter.
		print(f'Currency: {self.code}')
		print(f'Trend: {self.trend}')
		print(f'Rating: {rating}')

currency1 = Currency('USD', 42, 'Weak')
currency2 = Currency('EUR', 55, 'Neutral')
currency3 = Currency('GBP', 2, 'Weak')
